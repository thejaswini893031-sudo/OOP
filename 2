import java.util.Scanner;
import java.text.DecimalFormat;

public class Convertor {
    static Scanner sc = new Scanner(System.in);
    static DecimalFormat f = new DecimalFormat("##.###");

    public static void main(String[] args) {
        System.out.println("Enter the code 1:Currency 2:Distance 3:Time");
        int code = sc.nextInt();

        if (code == 1) {
            System.out.println("Enter the Currency code 1:Euro 2:Dollar 3:Yen");
            int c = sc.nextInt();

            System.out.println("Enter amount in rupees");
            double amount = sc.nextDouble();

            if (c == 1) {
                double euro = amount / 80;
                System.out.println("Euro : " + f.format(euro));
                System.out.println("Enter amount in Euro");
                double e = sc.nextDouble();
                System.out.println("Rupees : " + f.format(e * 80));
            } else if (c == 2) {
                double dollar = amount / 66;
                System.out.println("Dollar : " + f.format(dollar));
                System.out.println("Enter amount in Dollar");
                double d = sc.nextDouble();
                System.out.println("Rupees : " + f.format(d * 66));
            } else if (c == 3) {
                double yen = amount / 0.61;
                System.out.println("Yen : " + f.format(yen));
            } else {
                System.out.println("Invalid Code");
            }

        } else if (code == 2) {
            System.out.println("Enter the Distance code 1:Meter 2:Miles");
            int d = sc.nextInt();

            if (d == 1) {
                System.out.println("Enter the meter");
                double meter = sc.nextDouble();
                System.out.println("Kilometer : " + f.format(meter * 0.001));

                System.out.println("Enter the Kilometer");
                double km = sc.nextDouble();
                System.out.println("Meter : " + f.format(km / 0.001));
            } else if (d == 2) {
                System.out.println("Enter the miles");
                double miles = sc.nextDouble();
                System.out.println("Kilometer : " + f.format(miles * 1.6093));

                System.out.println("Enter the Kilometer");
                double km = sc.nextDouble();
                System.out.println("Miles : " + f.format(km / 1.6093));
            } else {
                System.out.println("Invalid Code");
            }

        } else if (code == 3) {
            System.out.println("Enter the Time code 1:Minutes 2:Seconds");
            int t = sc.nextInt();

            if (t == 1) {
                System.out.println("Enter the Hour");
                double hour = sc.nextDouble();
                System.out.println("Minutes : " + f.format(hour * 60));

                System.out.println("Enter the Minute");
                double minute = sc.nextDouble();
                System.out.println("Hours : " + f.format(minute / 60));
            } else if (t == 2) {
                System.out.println("Enter the Hour");
                double hour = sc.nextDouble();
                System.out.println("Seconds : " + f.format(hour * 3600));

                System.out.println("Enter the Seconds");
                double second = sc.nextDouble();
                System.out.println("Hours : " + f.format(second / 3600));
            } else {
                System.out.println("Invalid Code");
            }
        } else {
            System.out.println("Invalid Code");
        }
    }
}

